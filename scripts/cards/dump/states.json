{
  "layouts": [
    {
      "id": "sidebar",
      "label": "Sidebar",
      "mobile": false
    },
    {
      "id": "mobile",
      "label": "Mobile",
      "mobile": true
    }
  ],
  "states": [
    {
      "id": "offer",
      "label": "Offer: text and card with image"
    },
    {
      "id": "offer-card-only",
      "label": "Offer: card only"
    },
    {
      "id": "offer-no-image",
      "label": "Offer: no image"
    },
    {
      "id": "offer-long",
      "label": "Offer: long headline and URL"
    },
    {
      "id": "share",
      "label": "Shared content: preview and title"
    },
    {
      "id": "share-long-title",
      "label": "Shared content: long title (one line)"
    },
    {
      "id": "share-no-preview",
      "label": "Shared content: no preview image"
    }
  ],
  "themes": [
    {
      "id": "default",
      "label": "New-team default (outline)",
      "vars": {
        "--q-primary-color": "#437D88",
        "--q-lighter-primary-color": "#b4cbcf",
        "--q-text-color": "#ffffff",
        "--q-button-background-color": "transparent",
        "--q-button-hover-background-color": "#437D8810",
        "--q-button-background-layer": "#ffffff",
        "--q-button-hover-background-layer": "#ffffff",
        "--q-button-text-color": "#437D88",
        "--q-button-hover-text-color": "#437D88",
        "--q-button-border-color": "#437D88",
        "--q-button-hover-border-color": "#437D88",
        "--q-button-border-radius": "4px",
        "--q-control-border-radius": "4px"
      }
    },
    {
      "id": "solid",
      "label": "Solid buttons",
      "vars": {
        "--q-primary-color": "#437D88",
        "--q-lighter-primary-color": "#b4cbcf",
        "--q-text-color": "#ffffff",
        "--q-button-background-color": "#437D88",
        "--q-button-hover-background-color": "#396a74",
        "--q-button-background-layer": "#437D88",
        "--q-button-hover-background-layer": "#396a74",
        "--q-button-text-color": "#ffffff",
        "--q-button-hover-text-color": "#ffffff",
        "--q-button-border-color": "#437D88",
        "--q-button-hover-border-color": "#396a74",
        "--q-button-border-radius": "4px",
        "--q-control-border-radius": "4px"
      }
    },
    {
      "id": "none",
      "label": "No theme (fallbacks)",
      "vars": {}
    }
  ],
  "assets": {
    "https://example.com/offer-hero.png": "../img/hero.svg",
    "https://example.com/offer-roadmap.png": "../img/feature-roadmap.svg",
    "https://example.com/share-synergy.png": "../img/feature-synergy.svg",
    "https://example.com/share-cloud.png": "../img/feature-cloud.svg"
  }
}
